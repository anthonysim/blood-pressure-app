# Copy to .env.local. Defaults below point at the local Docker Postgres (npm run db:up).
# Production: use your Neon *pooled* connection string instead.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/bp_tracker"

# Any long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="local-dev-secret-change-me-in-production-0123456789"

# Base URL of the app
BETTER_AUTH_URL="http://localhost:3000"

# Resend (password reset emails). Create a key with "Sending access" restricted to your domain.
# Optional in development: without it, emails are printed to the dev server log.
RESEND_API_KEY=""
EMAIL_FROM="BP Tracker <no-reply@anthonysim.dev>"
